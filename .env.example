# Mẫu TÊN BIẾN cần đặt. Ứng dụng KHÔNG tự đọc file .env: hãy đặt biến môi trường trong terminal, ví dụ (Git Bash):
#   export GEMINI_API_KEY="dán-key-của-bạn"
# hoặc đặt trong .streamlit/secrets.toml:  GEMINI_API_KEY = "dán-key-của-bạn"
# Lấy key miễn phí: https://aistudio.google.com/api-keys
# KHÔNG đưa key thật vào file này và KHÔNG commit api_key.txt, .env, .streamlit/secrets.toml.
GEMINI_API_KEY=
# Tuỳ chọn: đổi file nhật ký chat (mặc định app.py ghi outputs/chat_log.jsonl; đặt 0 để tắt)
# AGRI_CHAT_LOG=outputs/chat_log.jsonl
